rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Blog Comments & Live Chat Collection
    match /chats/{chatId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }
    
    // 2. User Profiles Collection
    match /users/{userId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // 3. Appointments Collection
    match /appointments/{appointmentId} {
      allow create: if true;
      allow read, update: if request.auth != null;
    }
    
    // 4. Contact Form Messages Collection
    match /contacts/{contactId} {
      allow create: if true;
      allow read: if request.auth != null;
    }
    
    // 5. Orders & E-Book Purchases Collection
    match /orders/{orderId} {
      allow create: if true;
      allow read: if request.auth != null;
    }
    
    // 6. Newsletter Subscribers Collection
    match /subscribers/{subscriberId} {
      allow create: if true;
      allow read: if request.auth != null;
    }
    
    // 7. Numerology Saved Readings
    match /numerology_readings/{readingId} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }
    
    // Fallback: Protect any other unmentioned collection
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
